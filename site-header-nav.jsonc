// Site header menu: the single source for every link in the header.
// After editing, run:  python3 inject_header.py
// That rewrites the header on every page that has the site-header markers.
// Lines starting with // are comments (the script removes them before reading the JSON).
// Labels are written in title case; the top-level ones are shown in capitals by CSS.
{
  "logo": {
    "href": "/",
    "src": "/TCJ Website Assets/logos/site-header-logo-white.png",
    "panelSrc": "/TCJ Website Assets/logos/site-header-logo-charcoal.png",
    "alt": "The Canadian Jetsetter",
    "width": 465,
    "height": 96
  },

  // Top-level menu, in display order
  "items": [
    {
      "kind": "dropdown",
      "id": "offerings",
      "label": "Offerings",
      "items": [
        { "label": "Jetsetter Free", "href": "/jetsetter-free.html" },
        { "label": "Jetsetter Economy", "href": "/economy.html" },
        { "label": "Jetsetter Premium", "href": "/jetsetter-premium.html" },
        { "label": "Points Handbook", "href": "/points-handbook.html" },
        { "label": "Golden Visa", "href": "/golden-visa.html" }
      ]
    },
    {
      "kind": "cards",
      "id": "cards",
      "label": "Cards",
      // To hide the Cards menu, change the next line to:  "enabled": false,
      "enabled": true,
      // The card pages live on the main domain under /cards/ (served by the cards site's Cloudflare Worker route).
      // Links and images use the full live address below, so they also work in a local preview.
      "cardsBase": "https://thecanadianjetsetter.com",
      // The card list is GENERATED by sync_cards.py from the cards site's public card list
      // (travel-cards-site/dist/cards/cards.json): groups and cards in the cards site's menu order.
      // Don't edit between the markers; build travel-cards-site, then run:  python3 sync_cards.py
      // cards-sync-start
      "groups": [
        { "heading": "American Express", "cards": [
          {"name": "The Platinum Card®", "href": "/cards/amex-platinum/", "image": "/cards/images/cards/amex-platinum.webp", "width": 480, "height": 304},
          {"name": "American Express Cobalt® Card", "href": "/cards/amex-cobalt/", "image": "/cards/images/cards/amex-cobalt.webp", "width": 480, "height": 304},
          {"name": "American Express® Gold Rewards Card", "href": "/cards/amex-gold-rewards/", "image": "/cards/images/cards/amex-gold-rewards.webp", "width": 480, "height": 304},
          {"name": "American Express® Aeroplan®* Reserve Card", "href": "/cards/amex-aeroplan-reserve/", "image": "/cards/images/cards/amex-aeroplan-reserve.webp", "width": 480, "height": 304},
          {"name": "American Express® Aeroplan®* Card", "href": "/cards/amex-aeroplan/", "image": "/cards/images/cards/amex-aeroplan.webp", "width": 480, "height": 304},
          {"name": "Marriott Bonvoy® American Express®* Card", "href": "/cards/marriott-bonvoy-amex/", "image": "/cards/images/cards/marriott-bonvoy-amex.webp", "width": 320, "height": 202},
          {"name": "Hilton Honors American Express® Card", "href": "/cards/hilton-honors-amex/", "image": "/cards/images/cards/hilton-honors-amex.webp", "width": 680, "height": 431}
        ] },
        { "heading": "Scotiabank", "cards": [
          {"name": "Scotiabank Passport® Visa Infinite +* Card", "href": "/cards/scotiabank-passport-visa-infinite-plus/", "image": "/cards/images/cards/scotiabank-passport-visa-infinite-plus.webp", "width": 828, "height": 521},
          {"name": "Scotiabank Passport® Visa Infinite Privilege* Card", "href": "/cards/scotiabank-passport-visa-infinite-privilege/", "image": "/cards/images/cards/scotiabank-passport-visa-infinite-privilege.webp", "width": 828, "height": 522},
          {"name": "Scotiabank Gold American Express® Card", "href": "/cards/scotiabank-gold-amex/", "image": "/cards/images/cards/scotiabank-gold-amex.webp", "width": 828, "height": 521},
          {"name": "Scotiabank Platinum American Express® Card", "href": "/cards/scotiabank-platinum-amex/", "image": "/cards/images/cards/scotiabank-platinum-amex.webp", "width": 828, "height": 522},
          {"name": "Scotiabank American Express® Card", "href": "/cards/scotiabank-amex/", "image": "/cards/images/cards/scotiabank-amex.webp", "width": 828, "height": 521}
        ] }
      ],
      // cards-sync-end
      // "All cards" link to this site's /cards/ page (cards/index.html): first in the dropdown, as the left-hand
      // column on desktop and the first row on mobile. Set "show": false to hide it.
      "allCards": { "label": "All cards", "href": "/cards/", "show": true }
    },
    { "kind": "link", "label": "Links", "href": "/links.html" },
    { "kind": "link", "label": "Blog", "href": "/blog.html" },
    { "kind": "link", "label": "Contact", "href": "/contact.html" }
  ]
}
